{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "jsx": "react",
    "esModuleInterop": true
  },
  "include": [
    "src",
    "tests"
  ]
}
